// ลิงก์ถาวรบน Cloudflare: ส่งผู้ใช้ต่อไปยัง Quick Tunnel ที่เครื่องในสำนักงานเปิดอยู่
// (ระบบจองตัวจริงรันบนเครื่องนั้นด้วย scripts/start-public.sh — ดูรายละเอียดในไฟล์ดังกล่าว)
{
  "name": "bangrak-room-booking",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL", "class_name": "TunnelTarget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelTarget"] }]
}
