// ระบบจองห้องประชุมบน Cloudflare Workers — Cloudflare ดึงโค้ดจาก GitHub และ deploy ให้เองเมื่อ push เข้า main
// ไม่ต้องเปิดเครื่องในสำนักงาน: หน้าเว็บมาจาก Static Assets (public/) ส่วนระบบและข้อมูลอยู่ใน Durable Object
// รายละเอียดและการตั้งค่า: deploy/CLOUDFLARE.md
{
  "name": "bangrak-room-booking",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "BookingApp" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelTarget"] },
    { "tag": "v2", "new_sqlite_classes": ["BookingApp"] },
  ],
  "observability": { "enabled": true },
}
